include_guard(GLOBAL)

option(PYOBF_NATIVE_DEMO_DECOY "Build an independent decoy package and separate outer-decoy variants" OFF)
get_filename_component(decoy_demo_source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(decoy_sample_sources "${decoy_demo_source}/decoy/payload.cpp;${decoy_demo_source}/decoy/compute.cpp")
set(PYOBF_NATIVE_DEMO_DECOY_SOURCES "${decoy_sample_sources}" CACHE STRING "Semicolon-separated decoy C++ sources")
set(PYOBF_NATIVE_DECOY_CFF_CONFIG "${decoy_demo_source}/recipes/decoy.json" CACHE FILEPATH "Independent decoy recipe")
set(PYOBF_NATIVE_DECOY_CFF_SOURCE_OPT "none" CACHE STRING "Decoy ordinary source optimization before CFF: none or O2")
set_property(CACHE PYOBF_NATIVE_DECOY_CFF_SOURCE_OPT PROPERTY STRINGS none O2)
string(SHA256 decoy_seed_hash "pyobf.native.decoy.cff.v1:${PYOBF_NATIVE_CFF_SEED}")
string(SUBSTRING "${decoy_seed_hash}" 0 8 decoy_seed_hex)
math(EXPR default_decoy_seed "0x${decoy_seed_hex}")
set(PYOBF_NATIVE_DECOY_CFF_SEED "${default_decoy_seed}" CACHE STRING "Independent public decoy CFF seed")
if(NOT PYOBF_NATIVE_DEMO_DECOY)
    return()
endif()
if(NOT PYOBF_NATIVE_DECOY_CFF_SOURCE_OPT STREQUAL "none" AND NOT PYOBF_NATIVE_DECOY_CFF_SOURCE_OPT STREQUAL "O2")
    message(FATAL_ERROR "Native decoy source optimization must be none or O2")
endif()
if(NOT PYOBF_NATIVE_DEMO_DECOY_SOURCES)
    message(FATAL_ERROR "An enabled native decoy needs at least one C++ source")
endif()
set(decoy_sources "")
foreach(source IN LISTS PYOBF_NATIVE_DEMO_DECOY_SOURCES)
    get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Native decoy source does not exist: ${source}")
    endif()
    list(APPEND decoy_sources "${source}")
endforeach()
list(LENGTH decoy_sources source_count)
list(REMOVE_DUPLICATES decoy_sources)
list(LENGTH decoy_sources unique_source_count)
if(NOT source_count EQUAL unique_source_count)
    message(FATAL_ERROR "Native decoy sources must be unique")
endif()
get_filename_component(PYOBF_NATIVE_DECOY_CFF_CONFIG "${PYOBF_NATIVE_DECOY_CFF_CONFIG}" ABSOLUTE)
if(NOT EXISTS "${PYOBF_NATIVE_DECOY_CFF_CONFIG}" OR IS_DIRECTORY "${PYOBF_NATIVE_DECOY_CFF_CONFIG}")
    message(FATAL_ERROR "Native decoy recipe does not exist")
endif()
