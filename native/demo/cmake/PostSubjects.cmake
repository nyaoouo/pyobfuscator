include_guard(GLOBAL)
set(PYOBF_NATIVE_DEMO_POST_SUBJECTS "" CACHE FILEPATH "Early exact parent/child post-release subject JSON")
set(PYOBF_DEMO_POST_PARENT_KIND 1)
set(PYOBF_DEMO_POST_CHILD_KIND 1)
set(PYOBF_DEMO_POST_PARENT_HELPERS 0)
set(PYOBF_DEMO_POST_CHILD_HELPERS 0)
if(PYOBF_NATIVE_DEMO_POST_SUBJECTS)
    if(NOT PYOBF_NATIVE_DEMO_POST_CODE_HASH)
        message(FATAL_ERROR "Post subject selection requires post-release code measurement")
    endif()
    get_filename_component(PYOBF_NATIVE_DEMO_POST_SUBJECTS "${PYOBF_NATIVE_DEMO_POST_SUBJECTS}" ABSOLUTE)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/post_subjects.py"
        "${PYOBF_NATIVE_DEMO_POST_SUBJECTS}" --properties RESULT_VARIABLE result OUTPUT_VARIABLE kinds
        ERROR_VARIABLE reason OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Invalid post-release subjects: ${reason}")
    endif()
    list(GET kinds 0 PYOBF_DEMO_POST_PARENT_KIND)
    list(GET kinds 1 PYOBF_DEMO_POST_CHILD_KIND)
    list(GET kinds 2 PYOBF_DEMO_POST_PARENT_HELPERS)
    list(GET kinds 3 PYOBF_DEMO_POST_CHILD_HELPERS)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PYOBF_NATIVE_DEMO_POST_SUBJECTS}"
        "${PROJECT_SOURCE_DIR}/tools/post_subjects.py" "${PROJECT_SOURCE_DIR}/tools/reference_plan.py"
        "${PROJECT_SOURCE_DIR}/tools/reference_identity.py")
endif()

function(pyobf_native_demo_post_objects output raw_target)
    set(bindings "")
    if(PYOBF_NATIVE_DEMO_PRE_CODE_HASH)
        set(first 1)
    else()
        set(first 0)
    endif()
    if(PYOBF_DEMO_POST_PARENT_KIND EQUAL 3)
        get_target_property(object ${raw_target} PYOBF_NATIVE_MEASURED_OBJECT)
        if(NOT object)
            message(FATAL_ERROR "A parent function subject requires its actual native object")
        endif()
        list(APPEND bindings "${first}=${object}")
    endif()
    if(PYOBF_DEMO_POST_CHILD_KIND EQUAL 3)
        math(EXPR inner "${first} + 1")
        list(APPEND bindings "${inner}=${payload_object}")
    endif()
    set(${output} ${bindings} PARENT_SCOPE)
endfunction()

function(pyobf_native_demo_post_ownership manifests_out reports_out raw_target)
    set(manifests "")
    set(reports "")
    if(PYOBF_NATIVE_DEMO_PRE_CODE_HASH)
        set(first 1)
    else()
        set(first 0)
    endif()
    if(PYOBF_DEMO_POST_PARENT_HELPERS)
        get_target_property(object ${raw_target} PYOBF_NATIVE_MEASURED_OBJECT)
        get_target_property(report ${raw_target} PYOBF_NATIVE_MEASURED_OWNERSHIP_REPORT)
        if(NOT object OR NOT report)
            message(FATAL_ERROR "A generated parent subject requires its actual object and compiler report")
        endif()
        list(APPEND manifests "${first}=${object}.ownership.json")
        list(APPEND reports "${first}=${report}")
    endif()
    if(PYOBF_DEMO_POST_CHILD_HELPERS)
        math(EXPR inner "${first} + 1")
        list(APPEND manifests "${inner}=${payload_object}.ownership.json")
        list(APPEND reports "${inner}=${cff_report}")
    endif()
    set(${manifests_out} ${manifests} PARENT_SCOPE)
    set(${reports_out} ${reports} PARENT_SCOPE)
endfunction()

function(pyobf_native_demo_post_arguments output raw_target)
    set(options "")
    if(PYOBF_NATIVE_DEMO_POST_SUBJECTS)
        list(APPEND options --post-subjects "${PYOBF_NATIVE_DEMO_POST_SUBJECTS}")
    endif()
    pyobf_native_demo_post_objects(bindings ${raw_target})
    foreach(binding IN LISTS bindings)
        list(APPEND options --post-object "${binding}")
    endforeach()
    pyobf_native_demo_post_ownership(manifests reports ${raw_target})
    foreach(binding IN LISTS manifests)
        list(APPEND options --post-ownership "${binding}")
    endforeach()
    foreach(binding IN LISTS reports)
        list(APPEND options --post-ownership-report "${binding}")
    endforeach()
    set(${output} ${options} PARENT_SCOPE)
endfunction()
